# Normalize line endings to LF in the repo; Git converts to CRLF on Windows checkout only for files marked text=auto (default behavior).
* text=auto eol=lf

# Diff/merge as binary for assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
